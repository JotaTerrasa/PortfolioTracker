# Backend
SERVER_PORT=3001

# Vercel/Neon Postgres (production)
# In Vercel, add a Postgres/Neon integration to get this automatically.
DATABASE_URL=postgres://user:password@host/db

# Optional secret used by Vercel Cron when calling /api/snapshot
CRON_SECRET=your_random_secret

# Optional dashboard authentication
# If DASHBOARD_PASSWORD is set, /api/* requires a valid token from /api/auth/login
DASHBOARD_PASSWORD=your_dashboard_password
# Strong signing secret for auth tokens.
# REQUIRED in production when DASHBOARD_PASSWORD is enabled (min 32 chars recommended).
AUTH_SECRET=replace_with_a_random_secret_at_least_32_chars_long
# Optional comma-separated list of allowed browser origins for CORS.
# Leave empty in local dev to allow all origins.
# Example: CORS_ALLOWLIST=https://portfolio.example.com,https://www.portfolio.example.com
CORS_ALLOWLIST=
# Optional login protection tuning
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=600000
LOGIN_BLOCK_MS=900000
# Optional auto-snapshot cooldown (minutes) when dashboard usage triggers /api/balance
# Useful for Vercel plans with low-frequency cron limits.
AUTO_SNAPSHOT_COOLDOWN_MINUTES=60

# Exchange API keys
BINGX_API_KEY=your_bingx_api_key
BINGX_SECRET_KEY=your_bingx_secret_key
BITPANDA_API_KEY=your_bitpanda_api_key

# Optional manual average prices / cost basis overrides
# Pattern:
#   BINGX_AVG_PRICE_<SYMBOL>=0
#   BITPANDA_AVG_PRICE_<SYMBOL>=0
# Example:
# BINGX_AVG_PRICE_ASTER=0.88
# BITPANDA_AVG_PRICE_ASTER=1.85
